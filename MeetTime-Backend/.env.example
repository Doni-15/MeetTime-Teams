NODE_ENV=development
PORT=5000

# Pilih connection string atau parameter DB_*.
DATABASE_URL=
POSTGRES_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meettime
DB_USER=postgres
DB_PASSWORD=

# Production selalu memverifikasi sertifikat TLS. Isi salah satu CA hanya jika
# provider database menggunakan CA khusus.
DB_SSL=false
DB_SSL_CA=
DB_SSL_CA_FILE=

# Minimal 32 karakter pada production.
JWT_SECRET=
CLIENT_URL=http://localhost:5173
TRUST_PROXY_HOPS=0

# Hanya untuk `npm run seed:dev`; minimal 12 karakter dan dilarang di production.
MEETTIME_SEED_PASSWORD=
